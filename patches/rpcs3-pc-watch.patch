 extern void xmb_trace_bclr(ppu_thread& ppu, u32 target);
+extern bool g_xmb_pc_trace;
+extern void xmb_pc_trace_branch(ppu_thread& ppu, u32 source, u32 target);
 
 // NaNs production precedence: NaN from Va, Vb, Vc
 // and lastly the result of the operation in case none of the operands is a NaN
@@ -3304,6 +3306,7 @@ auto B()
 	ppu_record_call<Flags...>(ppu, ppu.cia, op);
 
 	ppu.cia = (op.aa ? 0 : ppu.cia) + op.bt24;
+	if (g_xmb_pc_trace) [[unlikely]] xmb_pc_trace_branch(ppu, link - 4, ppu.cia);
 	if (op.lk) ppu.lr = link;
 	ppu.exec_bytes += link - old_cia;
 	};
@@ -3489,6 +3492,7 @@ auto BCCTR()
 	{
 		const u32 target = static_cast<u32>(ppu.ctr) & ~3;
 		if (g_xmb_trace) [[unlikely]] xmb_trace_bcctr(ppu, vm::get_addr(this_op), target);
+		if (g_xmb_pc_trace) [[unlikely]] xmb_pc_trace_branch(ppu, vm::get_addr(this_op), target);
 		ppu_record_call<Flags...>(ppu, target, op, true);
 		ppu.cia = target;
 	}
