+// XMB entry-point watch (C:\dev\xmb, page-move trace 2026-11-05; local change, not upstream).
+// XMB_PC_TRACE=<out file> and XMB_PC_WATCH=<hex,...> (raw guest addresses): every taken b/bl/bcctr to a watched
+// address logs r3..r8, f1..f4, lr and up to 8 saved return addresses from the stack back chain. Interpreter only.
+namespace xmb_pc_trace
+{
+	u32 g_watch[16]{};
+	u32 g_count = 0;
+	FILE* g_file = nullptr;
+	std::mutex g_mutex;
+	atomic_t<u64> g_seq = 0;
+	u64 g_max = 50000;
+	std::string g_prx; // XMB_PC_WATCH_PRX: watch values are offsets from this module's first segment
+	atomic_t<bool> g_ready = true;
+	struct dump_spec { u32 reg, deref, off, count; };
+	dump_spec g_dumps[8]{};
+	u32 g_dump_count = 0;
+
+	bool init()
+	{
+		const char* out = std::getenv("XMB_PC_TRACE");
+		const char* watch = std::getenv("XMB_PC_WATCH");
+		if (!out || !*out || !watch || !*watch) return false;
+		for (const char* p = watch; *p && g_count < 16;)
+		{
+			char* end = nullptr;
+			const unsigned long v = std::strtoul(p, &end, 16);
+			if (end == p) break;
+			g_watch[g_count++] = static_cast<u32>(v);
+			p = *end == ',' ? end + 1 : end;
+		}
+		if (const char* max = std::getenv("XMB_PC_TRACE_MAX"); max && *max) g_max = std::strtoull(max, nullptr, 0);
+		if (const char* prx = std::getenv("XMB_PC_WATCH_PRX"); prx && *prx) { g_prx = prx; g_ready = false; }
+		// XMB_PC_DUMP=<reg>,<deref|->,<off>,<count>;... (hex): log count words at gpr[reg] (+deref, read as a pointer) + off.
+		if (const char* dump = std::getenv("XMB_PC_DUMP"); dump && *dump)
+		{
+			for (const char* p = dump; *p && g_dump_count < 8;)
+			{
+				dump_spec d{};
+				char* end = nullptr;
+				d.reg = static_cast<u32>(std::strtoul(p, &end, 16));
+				if (*end != ',') break;
+				p = end + 1;
+				if (*p == '-') { d.deref = umax; p++; }
+				else { d.deref = static_cast<u32>(std::strtoul(p, &end, 16)); p = end; }
+				if (*p != ',') break;
+				d.off = static_cast<u32>(std::strtoul(p + 1, &end, 16));
+				if (*end != ',') break;
+				d.count = std::min<u32>(64, static_cast<u32>(std::strtoul(end + 1, &end, 16)));
+				g_dumps[g_dump_count++] = d;
+				p = *end == ';' ? end + 1 : end;
+			}
+		}
+		if (!g_count || !(g_file = std::fopen(out, "w"))) return false;
+		std::fprintf(g_file, "# xmb pc watch: %u addresses, max %llu hits\n", g_count, static_cast<unsigned long long>(g_max));
+		std::fflush(g_file);
+		return true;
+	}
+}
+
+bool g_xmb_pc_trace = xmb_pc_trace::init();
+
+// Called by sys_prx after a module loads: rebases the watch offsets onto XMB_PC_WATCH_PRX's first segment.
+void xmb_pc_trace_on_prx(const std::string& name, u32 base)
+{
+	using namespace xmb_pc_trace;
+	if (!g_xmb_pc_trace || g_prx.empty() || g_ready || name.find(g_prx) == umax) return;
+	std::lock_guard lock(g_mutex);
+	for (u32 i = 0; i < g_count; i++) g_watch[i] += base;
+	std::fprintf(g_file, "# prx %s base %08X\n", name.c_str(), base);
+	std::fflush(g_file);
+	g_ready = true;
+}
+
+void xmb_pc_trace_branch(ppu_thread& ppu, u32 source, u32 target)
+{
+	using namespace xmb_pc_trace;
+	if (!g_ready) return;
+	bool hit = false;
+	for (u32 i = 0; i < g_count; i++) hit |= g_watch[i] == target;
+	if (!hit) return;
+	const u64 seq = ++g_seq;
+	if (seq > g_max) return;
+	char buf[2048];
+	int n = std::snprintf(buf, sizeof(buf), "%llu T%08X tgt=%08X src=%08X lr=%08X r3=%llX r4=%llX r5=%llX r6=%llX r7=%llX r8=%llX f1=%g f2=%g f3=%g f4=%g bt=",
+		static_cast<unsigned long long>(seq), ppu.id, target, source, static_cast<u32>(ppu.lr), ppu.gpr[3], ppu.gpr[4], ppu.gpr[5],
+		ppu.gpr[6], ppu.gpr[7], ppu.gpr[8], ppu.fpr[1], ppu.fpr[2], ppu.fpr[3], ppu.fpr[4]);
+	u32 sp = static_cast<u32>(ppu.gpr[1]);
+	for (int k = 0; k < 8 && n > 0 && n < static_cast<int>(sizeof(buf)) - 16; k++)
+	{
+		if (!vm::check_addr(sp, vm::page_readable, 8)) break;
+		const u32 back = static_cast<u32>(vm::read64(sp));
+		if (!back || back <= sp || !vm::check_addr(back, vm::page_readable, 24)) break;
+		n += std::snprintf(buf + n, sizeof(buf) - n, "%08X,", static_cast<u32>(vm::read64(back + 16)));
+		sp = back;
+	}
+	if (const auto rsx = rsx::get_current_renderer(); rsx && n > 0 && n < static_cast<int>(sizeof(buf)) - 64)
+		n += std::snprintf(buf + n, sizeof(buf) - n, " flip=%llu vbl=%llu tb=%llu", static_cast<unsigned long long>(rsx->int_flip_index),
+			static_cast<unsigned long long>(rsx->vblank_count.load()), static_cast<unsigned long long>(get_timebased_time()));
+	for (u32 i = 0; i < g_dump_count && n > 0 && n < static_cast<int>(sizeof(buf)) - 32; i++)
+	{
+		const dump_spec& d = g_dumps[i];
+		u32 addr = static_cast<u32>(ppu.gpr[d.reg & 31]);
+		if (d.deref != umax)
+		{
+			if (!vm::check_addr(addr + d.deref, vm::page_readable, 4)) continue;
+			addr = vm::read32(addr + d.deref);
+		}
+		addr += d.off;
+		n += std::snprintf(buf + n, sizeof(buf) - n, " d%u@%08X=", i, addr);
+		for (u32 k = 0; k < d.count && n > 0 && n < static_cast<int>(sizeof(buf)) - 12; k++)
+			n += std::snprintf(buf + n, sizeof(buf) - n, vm::check_addr(addr + k * 4, vm::page_readable, 4) ? "%08X," : "--------,",
+				vm::check_addr(addr + k * 4, vm::page_readable, 4) ? static_cast<u32>(vm::read32(addr + k * 4)) : 0u);
+	}
+	std::lock_guard lock(g_mutex);
+	std::fputs(buf, g_file);
+	std::fputc('\n', g_file);
+	std::fflush(g_file);
+}
+
 void xmb_trace_syscall(ppu_thread& ppu, u64 code, bool after)
 {
 	using namespace xmb_trace;
