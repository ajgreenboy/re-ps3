+// XMB entry-point watch (C:\dev\xmb, page-move trace 2026-11-05; local change, not upstream).
+// XMB_PC_TRACE=<out file> and XMB_PC_WATCH=<hex,...> (raw guest addresses): every taken b/bl/bcctr to a watched
+// address logs r3..r8, f1..f4, lr and up to 8 saved return addresses from the stack back chain. Interpreter only.
+namespace xmb_pc_trace
+{
+	u32 g_watch[16]{};
+	u32 g_count = 0;
+	FILE* g_file = nullptr;
+	std::mutex g_mutex;
+	atomic_t<u64> g_seq = 0;
+	u64 g_max = 50000;
+
+	bool init()
+	{
+		const char* out = std::getenv("XMB_PC_TRACE");
+		const char* watch = std::getenv("XMB_PC_WATCH");
+		if (!out || !*out || !watch || !*watch) return false;
+		for (const char* p = watch; *p && g_count < 16;)
+		{
+			char* end = nullptr;
+			const unsigned long v = std::strtoul(p, &end, 16);
+			if (end == p) break;
+			g_watch[g_count++] = static_cast<u32>(v);
+			p = *end == ',' ? end + 1 : end;
+		}
+		if (const char* max = std::getenv("XMB_PC_TRACE_MAX"); max && *max) g_max = std::strtoull(max, nullptr, 0);
+		if (!g_count || !(g_file = std::fopen(out, "w"))) return false;
+		std::fprintf(g_file, "# xmb pc watch: %u addresses, max %llu hits\n", g_count, static_cast<unsigned long long>(g_max));
+		std::fflush(g_file);
+		return true;
+	}
+}
+
+bool g_xmb_pc_trace = xmb_pc_trace::init();
+
+void xmb_pc_trace_branch(ppu_thread& ppu, u32 source, u32 target)
+{
+	using namespace xmb_pc_trace;
+	bool hit = false;
+	for (u32 i = 0; i < g_count; i++) hit |= g_watch[i] == target;
+	if (!hit) return;
+	const u64 seq = ++g_seq;
+	if (seq > g_max) return;
+	char buf[768];
+	int n = std::snprintf(buf, sizeof(buf), "%llu T%08X tgt=%08X src=%08X lr=%08X r3=%llX r4=%llX r5=%llX r6=%llX r7=%llX r8=%llX f1=%g f2=%g f3=%g f4=%g bt=",
+		static_cast<unsigned long long>(seq), ppu.id, target, source, static_cast<u32>(ppu.lr), ppu.gpr[3], ppu.gpr[4], ppu.gpr[5],
+		ppu.gpr[6], ppu.gpr[7], ppu.gpr[8], ppu.fpr[1], ppu.fpr[2], ppu.fpr[3], ppu.fpr[4]);
+	u32 sp = static_cast<u32>(ppu.gpr[1]);
+	for (int k = 0; k < 8 && n > 0 && n < static_cast<int>(sizeof(buf)) - 16; k++)
+	{
+		if (!vm::check_addr(sp, vm::page_readable, 8)) break;
+		const u32 back = static_cast<u32>(vm::read64(sp));
+		if (!back || back <= sp || !vm::check_addr(back, vm::page_readable, 24)) break;
+		n += std::snprintf(buf + n, sizeof(buf) - n, "%08X,", static_cast<u32>(vm::read64(back + 16)));
+		sp = back;
+	}
+	std::lock_guard lock(g_mutex);
+	std::fputs(buf, g_file);
+	std::fputc('\n', g_file);
+	std::fflush(g_file);
+}
