      "probes": [
        { "id": "track", "kind": "track", "region": [200, 205, 1500, 145], "params": { "template": [536, 276, 48, 48], "dx": 320, "dy": 26, "step": 6, "scales": [1.0, 1.08] } },
        { "id": "bar", "kind": "bar", "region": [0, 205, 1920, 145], "params": { "r": 9, "k": 12, "gap": 8, "minRun": 10, "minCol": 2, "pitchMin": 150, "pitchMax": 300, "focusAt": 565 } },
        { "id": "backdrop", "kind": "luma", "region": [0, 225, 260, 170], "params": { "sample": 2 } }
      ],
      "console": {
        "dir": "C:/dev/out/rpcs3-xmb-cap/burst-png",
        "match": "^f_(\\d+)\\.png$",
        "timeIndex": 1,
        "timeUnit": "ms",
        "crop": [0, 220, 1920, 180],
        "timeRange": [2700, 3350],
        "keyMs": 2706,
        "source": "C:/dev/out/rpcs3-xmb-cap/burst-png (burst.ps1 key log: PgUp at 2706 ms)"
      },
      "native": {
        "dir": "C:/dev/out/transitions/native/page-close",
        "match": "^page-close_(\\d+)_(\\d+)ms\\.png$",
        "timeIndex": 2,
        "timeUnit": "ms",
        "crop": [0, 0, 1920, 1080],
