        "params": {
          "track": { "template": [541, 231, 48, 48], "dx": 340, "dy": 30 }
        },
        "source": "C:/dev/out/transitions/native/page-close (re-ps3-native burst=@ESC)"
      },
      "capture": {
        "tokens": ["full", "wait", "LEFT", "LEFT", "LEFT", "LEFT", "LEFT", "wait", "ENTER", "wait", "wait", "grab=<prefix>-before.png", "burst=<prefix>@ESC", "wait", "wait", "grab=<prefix>-after.png", "quit"],
