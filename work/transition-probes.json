        "Native: two RIGHT from boot reach PSN; the burst presses LEFT back into Network."
      ],
      "probes": [
        { "id": "track", "kind": "track", "region": [300, 205, 1200, 145], "params": { "template": [536, 256, 48, 48], "dx": 240, "dy": 20, "step": 4, "scales": [1.0] } },
        { "id": "bar", "kind": "bar", "region": [0, 205, 1920, 145], "params": { "r": 9, "k": 12, "gap": 8, "minRun": 10, "minCol": 2, "pitchMin": 150, "pitchMax": 300, "focusAt": 565 } },
        { "id": "label", "kind": "label", "region": [0, 325, 1920, 60], "params": { "r": 6, "k": 14, "rowPad": 10, "minRows": 2, "blockGap": 22, "minBlock": 20 } },
        { "id": "row", "kind": "label", "region": [560, 455, 1360, 130], "params": { "r": 5, "k": 14, "rowPad": 12, "minRows": 2, "blockGap": 26, "minBlock": 40 } },
        { "id": "rows", "kind": "rows", "region": [640, 455, 1280, 405], "params": { "r": 5, "k": 18, "minRowInk": 60, "rowGap": 12, "minRowH": 6, "labelGap": 12, "minLabelWidth": 30 } },
        { "id": "backdrop", "kind": "luma", "region": [0, 600, 1920, 240], "params": { "sample": 3 } }
