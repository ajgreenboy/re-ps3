{
  "version": 1,
  "outDir": "C:/dev/out/transitions",
  "note": "Probe geometry is in full-frame 1080p coordinates. A sequence declares its capture crop, so a probe whose region falls outside that crop is reported as unavailable instead of guessed. Per-side geometry lives in each sequence's params, because a band crop and a framebuffer grab never share a y origin.",
  "toleranceDefaults": {
    "bar.focusX": { "pass": 3, "warn": 8, "unit": "px", "source": "console settled-tail sigma, 2x band" },
    "bar.focusY": { "pass": 14, "warn": 34, "unit": "px", "source": "capture-window placement, not the animation" },
    "bar.focusW": { "pass": 5, "warn": 12, "unit": "px", "source": "glyph quad size; console sigma about 1 px" },
    "bar.focusH": { "pass": 5, "warn": 12, "unit": "px", "source": "glyph quad size" },
    "bar.focusMass": { "pass": 6000, "warn": 15000, "unit": "ink px", "source": "ink mass of the focus blob; content dependent" },
    "bar.pitch": { "pass": 4, "warn": 10, "unit": "px", "source": "console bar pitch is a fixed 200 px grid; band is 2% of pitch" },
    "bar.count": { "pass": 1, "warn": 2, "unit": "blobs", "source": "icons merge at the focus slot on some frames" },
    "bar.merged": { "pass": 1, "warn": 1, "unit": "flag", "source": "flag only, never a verdict driver" },
    "bar.leftX": { "pass": 5, "warn": 12, "unit": "px", "source": "neighbour icon x" },
    "bar.rightX": { "pass": 5, "warn": 12, "unit": "px", "source": "neighbour icon x" },
    "bar.leftMass": { "pass": 6000, "warn": 15000, "unit": "ink px", "source": "neighbour ink mass" },
    "bar.rightMass": { "pass": 6000, "warn": 15000, "unit": "ink px", "source": "neighbour ink mass" },
    "bar.leftLuma": { "pass": 8, "warn": 20, "unit": "luma", "source": "neighbour icon peak luma" },
    "bar.rightLuma": { "pass": 8, "warn": 20, "unit": "luma", "source": "neighbour icon peak luma" },
    "label.left": { "pass": 4, "warn": 10, "unit": "px", "source": "text left edge; console settled sigma about 1 px" },
    "label.y": { "pass": 14, "warn": 34, "unit": "px", "source": "text line y; capture-window placement" },
    "label.peak": { "pass": 8, "warn": 20, "unit": "luma", "source": "label peak luma (alpha proxy)" },
    "label.mass": { "pass": 400, "warn": 1200, "unit": "ink px", "source": "label ink mass; glyph content differs per page" },
    "label.blocks": { "pass": 1, "warn": 2, "unit": "blocks", "source": "ghost separation; a merged pair loses one block" },
    "label.block0": { "pass": 6, "warn": 16, "unit": "px", "source": "text block left edge" },
    "label.block0End": { "pass": 8, "warn": 20, "unit": "px", "source": "text block right edge" },
    "label.block1": { "pass": 8, "warn": 20, "unit": "px", "source": "second text block (incoming set)" },
    "label.block1End": { "pass": 8, "warn": 20, "unit": "px", "source": "second text block" },
    "label.block2": { "pass": 8, "warn": 20, "unit": "px", "source": "third text block" },
    "label.block2End": { "pass": 8, "warn": 20, "unit": "px", "source": "third text block" },
    "label.block3": { "pass": 8, "warn": 20, "unit": "px", "source": "fourth text block" },
    "label.block3End": { "pass": 8, "warn": 20, "unit": "px", "source": "fourth text block" },
    "row.left": { "pass": 5, "warn": 12, "unit": "px", "source": "focused row label left edge" },
    "row.y": { "pass": 14, "warn": 34, "unit": "px", "source": "focused row label y; capture-window placement" },
    "row.peak": { "pass": 8, "warn": 20, "unit": "luma", "source": "label peak luma" },
    "row.mass": { "pass": 400, "warn": 1200, "unit": "ink px", "source": "label ink mass" },
    "row.blocks": { "pass": 1, "warn": 2, "unit": "blocks", "source": "ghost block count" },
    "row.block0": { "pass": 8, "warn": 20, "unit": "px", "source": "first label block" },
    "row.block0End": { "pass": 10, "warn": 24, "unit": "px", "source": "first label block end" },
    "row.block1": { "pass": 10, "warn": 24, "unit": "px", "source": "second label block" },
    "row.block1End": { "pass": 10, "warn": 24, "unit": "px", "source": "second label block end" },
    "row.block2": { "pass": 10, "warn": 24, "unit": "px", "source": "third label block" },
    "row.block2End": { "pass": 10, "warn": 24, "unit": "px", "source": "third label block end" },
    "row.block3": { "pass": 10, "warn": 24, "unit": "px", "source": "fourth label block" },
    "row.block3End": { "pass": 10, "warn": 24, "unit": "px", "source": "fourth label block end" },
    "rows.blockLeft": { "pass": 4, "warn": 10, "unit": "px", "source": "row block left edge" },
    "rows.blockTop": { "pass": 14, "warn": 34, "unit": "px", "source": "row block top; capture-window placement" },
    "rows.blockBottom": { "pass": 14, "warn": 34, "unit": "px", "source": "row block bottom" },
    "rows.y0": { "pass": 14, "warn": 34, "unit": "px", "source": "row y positions (capture-window placement)" },
    "rows.y1": { "pass": 14, "warn": 34, "unit": "px", "source": "row y positions" },
    "rows.y2": { "pass": 14, "warn": 34, "unit": "px", "source": "row y positions" },
    "rows.y3": { "pass": 14, "warn": 34, "unit": "px", "source": "row y positions" },
    "rows.y4": { "pass": 14, "warn": 34, "unit": "px", "source": "row y positions" },
    "rows.y5": { "pass": 14, "warn": 34, "unit": "px", "source": "row y positions" },
    "rows.left0": { "pass": 5, "warn": 12, "unit": "px", "source": "per-row label left edge" },
    "rows.left1": { "pass": 5, "warn": 12, "unit": "px", "source": "per-row label left edge" },
    "rows.left2": { "pass": 5, "warn": 12, "unit": "px", "source": "per-row label left edge" },
    "rows.left3": { "pass": 5, "warn": 12, "unit": "px", "source": "per-row label left edge" },
    "rows.left4": { "pass": 5, "warn": 12, "unit": "px", "source": "per-row label left edge" },
    "rows.left5": { "pass": 5, "warn": 12, "unit": "px", "source": "per-row label left edge" },
    "rows.count": { "pass": 1, "warn": 2, "unit": "rows", "source": "row count; content dependent" },
    "track.x": { "pass": 8, "warn": 16, "unit": "px", "source": "console settled-tail sigma (printed per run, about 1-2 px) plus template quantisation on the 1/16 p grid; 8 px is 3% of the 262 px page slide" },
    "track.y": { "pass": 14, "warn": 34, "unit": "px", "source": "template-track y; capture-window placement" },
    "track.scale": { "pass": 0.05, "warn": 0.12, "unit": "ratio", "source": "template scale; 5% of the quad" },
    "track.corr": { "pass": 0.25, "warn": 0.45, "unit": "ncc", "source": "track confidence, not geometry; a dip means the console icon is occluded mid-move" },
    "backdrop.mean": { "pass": 3, "warn": 8, "unit": "luma", "source": "console settled-tail sigma about 0.6 luma; band 3" },
    "backdrop.p99": { "pass": 6, "warn": 15, "unit": "luma", "source": "wave crest" },
    "backdrop.std": { "pass": 3, "warn": 8, "unit": "luma", "source": "backdrop contrast" },
    "backdrop.min": { "pass": 6, "warn": 16, "unit": "luma", "source": "backdrop floor" },
    "backdrop.max": { "pass": 6, "warn": 16, "unit": "luma", "source": "backdrop ceiling" },
    "panelLuma.mean": { "pass": 3, "warn": 8, "unit": "luma", "source": "panel glass brightness" },
    "panelLuma.p99": { "pass": 6, "warn": 15, "unit": "luma", "source": "panel glass highlight" },
    "panelLuma.std": { "pass": 3, "warn": 8, "unit": "luma", "source": "panel glass contrast" },
    "panelLuma.min": { "pass": 6, "warn": 16, "unit": "luma", "source": "panel glass floor" },
    "panelLuma.max": { "pass": 6, "warn": 16, "unit": "luma", "source": "panel glass ceiling" }
  },
  "transitions": [
    {
      "id": "page-open",
      "label": "Page open: ENTER on the Settings column",
      "driver": "track.x",
      "headline": ["track.x", "track.scale", "bar.pitch"],
      "view": [0, 180, 1920, 620],
      "knownMs": { "console": 300, "native": 300 },
      "notes": [
        "Console: 642-frame burst at 139.7 fps, band y220..380. The page load hides the first 709 ms after the press (PAGE-MOVE.md 2), so the window starts at 1280 ms; motion is measured from the frames.",
        "Native: 12-frame burst from ENTER. The first saved frame lands 20-160 ms after the key because grabFramebuffer costs a frame or three, so a preamble grab at rest supplies p=0."
      ],
      "probes": [
        { "id": "track", "kind": "track", "region": [200, 205, 1500, 145], "params": { "template": [281, 251, 48, 48], "dx": 320, "dy": 26, "step": 6, "scales": [1.0, 1.08, 1.16] } },
        { "id": "bar", "kind": "bar", "region": [0, 205, 1920, 145], "params": { "r": 9, "k": 12, "gap": 8, "minRun": 10, "minCol": 2, "pitchMin": 150, "pitchMax": 300, "focusAt": 565 } },
        { "id": "rows", "kind": "rows", "region": [640, 455, 1280, 405], "params": { "r": 5, "k": 18, "minRowInk": 60, "rowGap": 12, "minRowH": 6, "labelGap": 12, "minLabelWidth": 30 } },
        { "id": "backdrop", "kind": "luma", "region": [0, 225, 260, 170], "params": { "sample": 2 } }
      ],
      "console": {
        "dir": "C:/dev/out/rpcs3-xmb-cap/burst-png",
        "match": "^f_(\\d+)\\.png$",
        "timeIndex": 1,
        "timeUnit": "ms",
        "crop": [0, 220, 1920, 180],
        "timeRange": [1280, 1980],
        "keyMs": 707,
        "source": "C:/dev/out/rpcs3-xmb-cap/burst-png (burst.ps1 key log: PgDown at 707 ms)"
      },
      "native": {
        "dir": "C:/dev/out/transitions/native/page-open",
        "match": "^page-open_(\\d+)_(\\d+)ms\\.png$",
        "timeIndex": 2,
        "timeUnit": "ms",
        "crop": [0, 0, 1920, 1080],
        "prepend": [{ "file": "page-open-before.png", "t": 0 }],
        "params": {
          "track": { "template": [285, 231, 48, 48], "dx": 340, "dy": 30 }
        },
        "source": "C:/dev/out/transitions/native/page-open (re-ps3-native burst=@ENTER)"
      },
      "capture": {
        "tokens": ["full", "wait", "grab=<prefix>-before.png", "LEFT", "LEFT", "LEFT", "LEFT", "LEFT", "grab=<prefix>-at-settings.png", "burst=<prefix>@ENTER", "wait", "wait", "wait", "grab=<prefix>-after.png", "quit"],
        "expect": { "category": "settings", "depth": "1" },
        "note": "5 LEFT from the boot Game column reaches Settings (census 2026-10-28); ENTER opens it."
      }
    },
    {
      "id": "page-close",
      "label": "Page close: Circle (ESC) on the Settings page",
      "driver": "track.x",
      "headline": ["track.x", "track.scale", "bar.pitch"],
      "view": [0, 180, 1920, 620],
      "knownMs": { "console": 300, "native": 300 },
      "notes": [
