    {
      "id": "ps-tap",
      "label": "PS button tap: controller indicator",
      "mode": "endpoint",
      "driver": "bar.focusX",
      "headline": ["bar.focusX", "bar.pitch", "backdrop.mean"],
      "view": [0, 180, 1920, 700],
      "notes": [
        "NATIVE ONLY. No full-frame console still of the tap indicator is on disk: psfix/tap-*.png are crops with no recorded origin, and the rpcs3-allgraphics ps-menu-* frames are the root, not the indicator.",
        "Recorded so the next pass has a native reference; a verdict needs a console tap burst (see the missing-capture-token table in TRANSITION-HARNESS.md)."
      ],
      "probes": [
        { "id": "bar", "kind": "bar", "region": [0, 205, 1920, 145], "params": { "r": 9, "k": 12, "gap": 8, "minRun": 10, "minCol": 2, "pitchMin": 150, "pitchMax": 300, "focusAt": 565 } },
        { "id": "backdrop", "kind": "luma", "region": [0, 600, 1920, 240], "params": { "sample": 3 } }
      ],
      "endpoint": {
        "native": { "file": "C:/dev/out/transitions/native/ps-tap/ps-tap.png" }
      },
      "capture": {
        "tokens": ["full", "wait", "grab=<prefix>-before.png", "ps", "wait", "grab=<prefix>.png", "quit"],
        "note": "ps token replays the PS tap; the indicator is up at +300 ms."
      }
    },
    {
      "id": "ps-hold",
      "label": "PS button hold: system menu",
      "mode": "endpoint",
      "driver": "bar.focusX",
      "headline": ["bar.focusX", "bar.pitch", "backdrop.mean"],
      "view": [0, 180, 1920, 700],
      "notes": [
        "NATIVE ONLY for the same reason as ps-tap: the console PS-menu frames on disk (rpcs3-allgraphics ps-menu-open.png) show the root after the menu closed, so they are not the menu ground truth."
      ],
      "probes": [
        { "id": "bar", "kind": "bar", "region": [0, 205, 1920, 145], "params": { "r": 9, "k": 12, "gap": 8, "minRun": 10, "minCol": 2, "pitchMin": 150, "pitchMax": 300, "focusAt": 565 } },
        { "id": "backdrop", "kind": "luma", "region": [0, 600, 1920, 240], "params": { "sample": 3 } }
      ],
      "endpoint": {
        "native": { "file": "C:/dev/out/transitions/native/ps-hold/ps-hold.png" }
      },
      "capture": {
        "tokens": ["full", "wait", "pshold", "wait", "wait", "grab=<prefix>.png", "quit"],
        "note": "pshold token opens the system menu; grabbed at +600 ms."
      }
    }
  ]
}
