+// XMB reference capture (local change): XMB_SPU_WATCH also covers atomic 128-byte stores (putllc/putlluc).
+static void xmb_watch_atomic(spu_thread& spu, const char* kind, u32 addr)
+{
+	static const char* const dir = std::getenv("XMB_SPU_DUMP");
+	static const auto watch = []() -> std::pair<u32, u32>
+	{
+		const char* spec = std::getenv("XMB_SPU_WATCH");
+		if (!spec) return {0, 0};
+		u32 ea = 0, size = 0;
+		std::sscanf(spec, "%x:%x", &ea, &size);
+		return {ea, size};
+	}();
+	static atomic_t<u32> hits = 0;
+	if (!dir || !watch.second || addr + 128 <= watch.first || addr >= watch.first + watch.second || hits >= 4) return;
+	const u32 n = hits++;
+	if (FILE* f = std::fopen(fmt::format("%s/ls_atomic_%u.bin", dir, n).c_str(), "wb")) { std::fwrite(spu._ptr<u8>(0), 1, SPU_LS_SIZE, f); std::fclose(f); }
+	if (FILE* f = std::fopen(fmt::format("%s/watch.txt", dir).c_str(), "a")) { std::fprintf(f, "%u %s ea 0x%08x pc 0x%05x spu %s\n", n, kind, addr, spu.pc, spu.get_name().c_str()); std::fclose(f); }
+}
